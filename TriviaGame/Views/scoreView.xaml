<UserControl x:Class="TriviaGame.Views.scoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TriviaGame.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280"
             Background="Chocolate">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Views/Imagenes/Fondo.png"/>
        </Grid.Background>
        <Button Content="Menu"
        Command="{Binding menuPrinCommand}"
        Width="130"
        Height="42"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,43,622"
        FontSize="24"
        FontFamily="Bauhaus 93"
        Foreground="White"
        BorderThickness="0"
        Cursor="Hand" Click="Button_Click_1" >
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#004aad" Offset="0"/>
                    <GradientStop Color="#5ce1e6" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}"
                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
        <Label Content="Registros" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Height="149" Width="414" FontFamily="Bauhaus 93" FontSize="100" Foreground="Black"/>
        <Rectangle HorizontalAlignment="Center" Height="468" Margin="0,159,0,0" Stroke="Black" VerticalAlignment="Top" Width="1124" Fill="#7F21987F"/>
        <Rectangle HorizontalAlignment="Left" Height="70" Margin="78,159,0,0" Stroke="Black" VerticalAlignment="Top" Width="282" Fill="#7F21987F"/>
        <Rectangle HorizontalAlignment="Left" Height="70" Margin="359,159,0,0" Stroke="Black" VerticalAlignment="Top" Width="282" Fill="#7F21987F"/>
        <Rectangle HorizontalAlignment="Left" Height="70" Margin="640,159,0,0" Stroke="Black" VerticalAlignment="Top" Width="281" Fill="#7F21987F"/>
        <Rectangle HorizontalAlignment="Left" Height="70" Margin="920,159,0,0" Stroke="Black" VerticalAlignment="Top" Width="282" Fill="#7F21987F"/>
        <Label Content="Categoria" HorizontalAlignment="Left" Margin="125,162,0,0" VerticalAlignment="Top" FontFamily="Segoe UI Variable Display Semibold" FontSize="40"/>
        <Label Content="Aciertos" HorizontalAlignment="Left" Margin="419,162,0,0" VerticalAlignment="Top" FontFamily="Segoe UI Variable Display Semibold" FontSize="40"/>
        <Label Content="Errores" HorizontalAlignment="Left" Margin="710,162,0,0" VerticalAlignment="Top" FontFamily="Segoe UI Variable Display Semibold" FontSize="40"/>
        <Label Content="Puntuación" HorizontalAlignment="Left" Margin="953,162,0,0" VerticalAlignment="Top" FontFamily="Segoe UI Variable Display Semibold" FontSize="40"/>
        <Rectangle HorizontalAlignment="Left" Height="399" Margin="78,228,0,0" Stroke="Black" VerticalAlignment="Top" Width="282"/>
        <Rectangle HorizontalAlignment="Left" Height="399" Margin="359,228,0,0" Stroke="Black" VerticalAlignment="Top" Width="282"/>
        <Rectangle HorizontalAlignment="Left" Height="399" Margin="639,228,0,0" Stroke="Black" VerticalAlignment="Top" Width="282"/>
        <TextBlock Text="{Binding Categoria}" HorizontalAlignment="Left" Margin="106,248,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="352" Width="234" TextAlignment="Center" FontFamily="Segoe UI Variable Display Light" FontSize="25"/>
        <TextBlock Text="{Binding Aciertos}" HorizontalAlignment="Left" Margin="383,248,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="352" Width="234" TextAlignment="Center" FontFamily="Segoe UI Variable Display Light" FontSize="25"/>
        <TextBlock Text="{Binding Errores}" HorizontalAlignment="Left" Margin="664,248,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="352" Width="234" TextAlignment="Center" FontFamily="Segoe UI Variable Display Light" FontSize="25"/>
        <TextBlock Text="{Binding Puntuacion}" HorizontalAlignment="Left" Margin="946,248,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="352" Width="234" TextAlignment="Center" FontFamily="Segoe UI Variable Display Light" FontSize="25"/>
        
    </Grid>
</UserControl>
