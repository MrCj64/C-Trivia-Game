<UserControl x:Class="TriviaGame.Views.gameViewSonido"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TriviaGame.Views"
      mc:Ignorable="d" Width="1280" Height="720">

    <Grid Width="1280" Height="720">
        <Grid.Background>
            <ImageBrush ImageSource="/Views/Imagenes/Fondo.png"/>
        </Grid.Background>

        <Border BorderBrush="#FF57248E" BorderThickness="1"
                Margin="49,40,45,484" CornerRadius="40" Background="#B257248E">
            <TextBlock Text="{Binding TextoPregunta}"
                       TextWrapping="Wrap" Margin="0,25,0,0"
                       Width="1090" Height="148"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       FontFamily="Segoe UI Variable Display Semibold"
                       FontSize="35" Foreground="White"/>
        </Border>

        <Button HorizontalAlignment="Left" Margin="358,289,0,0" VerticalAlignment="Top"
                Height="178" Width="244"
                Background="{Binding ColorA}"
                BorderBrush="#FF7AD8D8" FocusVisualStyle="{x:Null}"
                Command="{Binding ResponderCommand}" CommandParameter="A">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" BorderBrush="#FF7AD8D9" BorderThickness="1"
                            CornerRadius="40" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFADFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Width="60" Height="60" Margin="0,0,0,8"
                        Command="{Binding ReproducirCommand}" CommandParameter="A"
                        Background="White" BorderThickness="0"
                        ToolTip="Reproducir audio A">
                    <TextBlock Text="▶" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <TextBlock Text="Opción A" FontSize="16"
                           FontFamily="Segoe UI Variable Display Light"
                           HorizontalAlignment="Center" Foreground="Black"/>
            </StackPanel>
        </Button>

        <Button HorizontalAlignment="Left" Margin="678,289,0,0" VerticalAlignment="Top"
                Height="178" Width="244"
                Background="{Binding ColorB}"
                BorderBrush="#FFF2D17B" FocusVisualStyle="{x:Null}"
                Command="{Binding ResponderCommand}" CommandParameter="B">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" BorderBrush="#FFF2D17B" BorderThickness="1"
                            CornerRadius="40" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFFFE100"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Width="60" Height="60" Margin="0,0,0,8"
                        Command="{Binding ReproducirCommand}" CommandParameter="B"
                        Background="White" BorderThickness="0" ToolTip="Reproducir audio B">
                    <TextBlock Text="▶" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <TextBlock Text="Opción B" FontSize="16"
                           FontFamily="Segoe UI Variable Display Light"
                           HorizontalAlignment="Center" Foreground="Black"/>
            </StackPanel>
        </Button>

        <Button HorizontalAlignment="Left" Margin="358,503,0,0" VerticalAlignment="Top"
                Height="178" Width="244"
                Background="{Binding ColorC}"
                BorderBrush="#FFDE5353" FocusVisualStyle="{x:Null}"
                Command="{Binding ResponderCommand}" CommandParameter="C">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" BorderBrush="#FFDE5353" BorderThickness="1"
                            CornerRadius="40" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFFF8080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Width="60" Height="60" Margin="0,0,0,8"
                        Command="{Binding ReproducirCommand}" CommandParameter="C"
                        Background="White" BorderThickness="0" ToolTip="Reproducir audio C">
                    <TextBlock Text="▶" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <TextBlock Text="Opción C" FontSize="16"
                           FontFamily="Segoe UI Variable Display Light"
                           HorizontalAlignment="Center" Foreground="Black"/>
            </StackPanel>
        </Button>

        <Button HorizontalAlignment="Left" Margin="678,503,0,0" VerticalAlignment="Top"
                Height="178" Width="244"
                Background="{Binding ColorD}"
                BorderBrush="#FF6CB079" FocusVisualStyle="{x:Null}"
                Command="{Binding ResponderCommand}" CommandParameter="D">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" BorderBrush="#FF7AD8D9" BorderThickness="1"
                            CornerRadius="40" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFB2FF59"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Width="60" Height="60" Margin="0,0,0,8"
                        Command="{Binding ReproducirCommand}" CommandParameter="D"
                        Background="White" BorderThickness="0" ToolTip="Reproducir audio D">
                    <TextBlock Text="▶" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <TextBlock Text="Opción D" FontSize="16"
                           FontFamily="Segoe UI Variable Display Light"
                           HorizontalAlignment="Center" Foreground="Black"/>
            </StackPanel>
        </Button>
        <Label x:Name="Timer" Content="10" HorizontalAlignment="Left" Margin="1156,567,0,0" VerticalAlignment="Top" Height="89" Width="114" FontSize="72" FontFamily="Arial Black" Foreground="White"/>

    </Grid>
</UserControl>
