<UserControl x:Class="TriviaGame.Views.gameViewImagen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TriviaGame.Views"
      mc:Ignorable="d" Height="720" Width="1280">

    <Grid Width="1280" Height="720">
        <Grid.Background>
            <ImageBrush ImageSource="/Views/Imagenes/Fondo.png"/>
        </Grid.Background>

        <Border BorderBrush="#FF57248E" BorderThickness="1"
                Margin="49,40,71,546" CornerRadius="40" Background="#B257248E">
            <TextBlock Text="{Binding TextoPregunta}"
                       TextWrapping="Wrap" Margin="0,13,0,0"
                       Width="990" Height="110"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       FontFamily="Segoe UI Variable Display Semibold"
                       FontSize="35" Foreground="White"/>
        </Border>

        <Button HorizontalAlignment="Left" Margin="110,218,0,0" VerticalAlignment="Top"
                Height="213" Width="450"
                Background="{Binding ColorA}"
                BorderBrush="#FF7AD8D8" FocusVisualStyle="{x:Null}"
                Command="{Binding ResponderCommand}" CommandParameter="A" Click="AnswerButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" BorderBrush="#FF7AD8D9" BorderThickness="1"
                            CornerRadius="40" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFADFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Image Source="{Binding RutaA}" Height="171" Width="298" Stretch="Uniform"/>
        </Button>

        <Button HorizontalAlignment="Left" Margin="700,218,0,0" VerticalAlignment="Top"
                Height="213" Width="450"
                Background="{Binding ColorB}"
                BorderBrush="#FFF2D17B" FocusVisualStyle="{x:Null}"
                Command="{Binding ResponderCommand}" CommandParameter="B" Click="AnswerButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" BorderBrush="#FFF2D17B" BorderThickness="1"
                            CornerRadius="40" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFFFE100"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Image Source="{Binding RutaB}" Height="171" Width="302" Stretch="Uniform" RenderTransformOrigin="0.998,0.462"/>
        </Button>

        <Button HorizontalAlignment="Left" Margin="110,468,0,0" VerticalAlignment="Top"
                Height="213" Width="450"
                Background="{Binding ColorC}"
                BorderBrush="#FFDE5353" FocusVisualStyle="{x:Null}"
                Command="{Binding ResponderCommand}" CommandParameter="C" Click="AnswerButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" BorderBrush="#FFDE5353" BorderThickness="1"
                            CornerRadius="40" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFFF8080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Image Source="{Binding RutaC}" Height="171" Width="312" Stretch="Uniform"/>
        </Button>

        <Button HorizontalAlignment="Left" Margin="700,468,0,0" VerticalAlignment="Top"
                Height="213" Width="450"
                Background="{Binding ColorD}"
                BorderBrush="#FF6CB079" FocusVisualStyle="{x:Null}"
                Command="{Binding ResponderCommand}" CommandParameter="D" Click="AnswerButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" BorderBrush="#FF7AD8D9" BorderThickness="1"
                            CornerRadius="40" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFB2FF59"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Image Source="{Binding RutaD}" Height="171" Width="283" Stretch="Uniform"/>
        </Button>
        <Label x:Name="Timer" Content="10" HorizontalAlignment="Left" Margin="1156,567,0,0" VerticalAlignment="Top" Height="89" Width="114" FontSize="72" FontFamily="Arial Black" Foreground="White"/>

    </Grid>
</UserControl>
