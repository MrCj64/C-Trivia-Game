<UserControl x:Class="TriviaGame.Views.Score"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TriviaGame.Views"
        mc:Ignorable="d"
        d:DesignHeight="720" d:DesignWidth="1280">
    <Grid RenderTransformOrigin="0.502,0.514" Width="1280" Height="720">
        <Grid.Background>
            <ImageBrush ImageSource="/Views/Imagenes/Fondo.png"/>
        </Grid.Background>
        <StackPanel x:Name="Player1" Margin="552,19,528,481" Width="200" Height="219">
            <Ellipse x:Name="Avatar1" Height="143.2" Stroke="#00000000" Width="140"/>
            <TextBlock x:Name="TxtUsuario1" TextWrapping="Wrap" Foreground="White" Text="Usuario1" FontSize="28" TextAlignment="Center"/>
            <TextBlock x:Name="Puntuacion1" TextWrapping="Wrap" Foreground="White" Text="300" FontSize="28" TextAlignment="Center" FontFamily="Showcard Gothic"/>
        </StackPanel>
        <Rectangle HorizontalAlignment="Left" Height="179" Margin="536,243,0,0" VerticalAlignment="Top" Width="243" Stroke="White" Fill="White"/>
        <Rectangle HorizontalAlignment="Left" Height="136" Margin="784,286,0,0" VerticalAlignment="Top" Width="244" Stroke="White" Fill="White"/>
        <StackPanel x:Name="Player2" Margin="806,72,274,428" Width="200" Height="219">
            <Ellipse x:Name="Avatar2" Height="143.2" Stroke="#00000000" Width="140"/>
            <TextBlock x:Name="TxtUsuario2" TextWrapping="Wrap" Foreground="White" Text="Usuario1" FontSize="28" TextAlignment="Center"/>
            <TextBlock x:Name="Puntuacion2" TextWrapping="Wrap" Foreground="White" Text="300" FontSize="28" TextAlignment="Center" FontFamily="Showcard Gothic"/>
        </StackPanel>
        <Rectangle HorizontalAlignment="Left" Height="96" Margin="288,326,0,0" VerticalAlignment="Top" Width="243" Stroke="White" Fill="White"/>
        <StackPanel x:Name="Player3" Margin="310,102,770,398" Width="200" Height="219">
            <Ellipse x:Name="Avatar3" Height="143.2" Stroke="#00000000" Width="140"/>
            <TextBlock x:Name="TxtUsuario3" TextWrapping="Wrap" Foreground="White" Text="Usuario1" FontSize="28" TextAlignment="Center"/>
            <TextBlock x:Name="Puntuacion3" TextWrapping="Wrap" Foreground="White" Text="300" FontSize="28" TextAlignment="Center" FontFamily="Showcard Gothic"/>
        </StackPanel>
        <StackPanel x:Name="Player4" Margin="555,435,525,65" Width="200" Height="219">
            <Ellipse x:Name="Avatar4" Height="143.2" Stroke="#00000000" Width="140"/>
            <TextBlock x:Name="TxtUsuario4" TextWrapping="Wrap" Foreground="White" Text="Usuario1" FontSize="28" TextAlignment="Center"/>
            <TextBlock x:Name="Puntuacion4" TextWrapping="Wrap" Foreground="White" Text="300" FontSize="28" TextAlignment="Center" FontFamily="Showcard Gothic"/>
        </StackPanel>
        <Rectangle HorizontalAlignment="Left" Height="100" Margin="602,243,0,0" Stroke="#00000000" VerticalAlignment="Top" Width="100">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Views/1ero.png"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle HorizontalAlignment="Left" Height="100" Margin="856,293,0,0" Stroke="#00000000" VerticalAlignment="Top" Width="100">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Views/2do.png"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle HorizontalAlignment="Left" Height="100" Margin="360,326,0,0" Stroke="#00000000" VerticalAlignment="Top" Width="100">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Views/3ro.png"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle HorizontalAlignment="Left" Height="100" Margin="755,518,0,0" Stroke="#00000000" VerticalAlignment="Top" Width="100">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Views/4to.png"/>
            </Rectangle.Fill>
        </Rectangle>
        <Button x:Name="BtnMenu" Content="Menu"
        Width="130"
        Height="42"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,66,66"
        FontSize="24"
        FontFamily="Bauhaus 93"
        Foreground="White"
        BorderThickness="0"
        Cursor="Hand" Click="BtnMenu_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#004aad" Offset="0"/>
                    <GradientStop Color="#5ce1e6" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}"
                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

    </Grid>
</UserControl>
