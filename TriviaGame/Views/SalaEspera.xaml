<Window x:Class="TriviaGame.Views.SalaEspera"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TriviaGame.Views"
        mc:Ignorable="d"
        Title="SalaEspera" Height="720" Width="1280">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="1280" Height="720">
        <Grid.Background>
            <ImageBrush ImageSource="/Views/Imagenes/Fondo.png"/>
        </Grid.Background>
        <StackPanel x:Name="Player1" Margin="133,221,897,264" Width="250" Height="235">
            <Ellipse x:Name="Avatar1" Height="180" Stroke="#00000000" Width="180"/>
            <TextBlock x:Name="TxtUsuario1" TextWrapping="Wrap" Foreground="White" Text="Usuario1" FontSize="28" TextAlignment="Center"/>
        </StackPanel>
        <TextBlock HorizontalAlignment="Center" Margin="0,548,0,0" TextWrapping="Wrap" Text="Esperando a los jugadores...." VerticalAlignment="Top" Height="31" Width="412" Foreground="White" TextAlignment="Center" FontSize="24" RenderTransformOrigin="0.474,3.566"/>
        <StackPanel x:Name="Player3" Margin="638,221,392,264" ScrollViewer.VerticalScrollBarVisibility="Hidden" Width="250" Height="235" Background="#00000000">
            <Ellipse x:Name="Avatar3" Height="180" Stroke="#00000000" Width="180"/>
            <TextBlock x:Name="TxtUsuario3" TextWrapping="Wrap" Foreground="White" Text="Usuario3" FontSize="28" TextAlignment="Center"/>
        </StackPanel>
        <StackPanel x:Name="Player2" Margin="383,221,647,264" Width="250" Height="235">
            <Ellipse x:Name="Avatar2" Height="180" Stroke="#00000000" Width="180"/>
            <TextBlock x:Name="TxtUsuario2" TextWrapping="Wrap" Foreground="White" Text="Usuario2" FontSize="28" TextAlignment="Center"/>
        </StackPanel>
        <Label x:Name="Timer" Content="19" HorizontalAlignment="Left" Margin="970,519,0,0" VerticalAlignment="Top" Height="89" Width="114" FontSize="72" FontFamily="Arial Black" Foreground="White" RenderTransformOrigin="-3.543,-1.737"/>
        <StackPanel x:Name="Player4" Margin="888,221,142,264" ScrollViewer.VerticalScrollBarVisibility="Hidden" Width="250" Height="235" Background="#00000000">
            <Ellipse x:Name="Avatar4" Height="180" Stroke="#00000000" Width="180"/>
            <TextBlock x:Name="TxtUsuario4" TextWrapping="Wrap" Foreground="White" Text="Usuario4" FontSize="28" TextAlignment="Center"/>
        </StackPanel>

    </Grid>
</Window>
