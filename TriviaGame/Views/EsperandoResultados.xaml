<UserControl x:Class="TriviaGame.Views.EsperandoResultados"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Width="1280" Height="720">
        <Grid.Background>
            <ImageBrush ImageSource="/Views/Imagenes/Fondo.png"/>
        </Grid.Background>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="¡Juego terminado!"
                       Foreground="White"
                       FontSize="48"
                       FontFamily="Showcard Gothic"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>
            <TextBlock Text="Esperando resultados de todos los jugadores..."
                       Foreground="White"
                       FontSize="24"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>
            <ProgressBar IsIndeterminate="True"
                         Width="400"
                         Height="20"
                         Foreground="#FFD700"
                         Background="#333"/>
        </StackPanel>
    </Grid>
</UserControl>
