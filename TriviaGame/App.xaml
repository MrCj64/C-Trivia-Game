<Application x:Class="TriviaGame.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:TriviaGame.ViewModels"
             xmlns:views="clr-namespace:TriviaGame.Views"
             xmlns:local="clr-namespace:TriviaGame"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DataTemplate DataType="{x:Type viewModels:mainMenuViewModel}">
            <views:mainMenuView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:inGameViewModel}">
            <views:gameView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:finalScoreViewModel}">
            <views:scoreView />
        </DataTemplate>
    </Application.Resources>
</Application>
